        {
          "@context": "https://schema.org",
          "@type": "FAQPage",
          "mainEntity": [
            {
              "@type": "Question",
              "name": "Czy usługa jest z operatorem?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Tak. Minikoparka jest dostarczana wraz z operatorem — nie wynajmujemy samego sprzętu. Operator wykonuje pracę i odpowiada za jej przebieg."
              }
            },
            {
              "@type": "Question",
              "name": "Na jakim terenie pracujecie?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Działamy we Wrocławiu i okolicach. Jeśli nie masz pewności, czy dojedziemy pod Twój adres, zadzwoń — potwierdzimy to podczas rozmowy."
              }
            },
            {
              "@type": "Question",
              "name": "Ile kosztuje usługa minikoparką?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Koszt zależy od rodzaju prac, głębokości, gruntu i czasu potrzebnego na realizację. Wyceniamy po krótkiej rozmowie telefonicznej — wystarczy opisać, co jest do zrobienia i podać lokalizację."
              }
            },
            {
              "@type": "Question",
              "name": "Jakim sprzętem wykonujecie prace?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Pracujemy minikoparką do 2 ton. Kompaktowe wymiary maszyny pozwalają pracować na ciasnych działkach, w ogrodach i za wąskimi przejazdami, gdzie większy sprzęt nie wjedzie."
              }
            },
            {
              "@type": "Question",
              "name": "W jakich godzinach można się kontaktować?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Telefon odbieramy od poniedziałku do piątku w godzinach 7:30–20:30 oraz w soboty w godzinach 8:00–18:30. W niedziele firma jest nieczynna."
              }
            },
            {
              "@type": "Question",
              "name": "Jak przygotować się do przyjazdu koparki?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Przed rozpoczęciem prac warto upewnić się, że znamy przebieg instalacji na działce (woda, prąd, gaz, kanalizacja) i wskazać dokładne miejsce prac. Szczegóły ustalamy podczas rozmowy telefonicznej."
              }
            }
          ]
        }
