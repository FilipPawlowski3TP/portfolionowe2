---
// Wordmark: text-based logo (no image logo exists — designed per MASTERPROMPT sekcja 3).
interface Props {
  size?: 'sm' | 'lg';
}

const { size = 'sm' } = Astro.props;
---

<span class:list={['wordmark', `wordmark--${size}`]} role="img" aria-label="Pawłowski Studio">
  <span class="wordmark__main" aria-hidden="true">PAWŁOWSKI</span>
  <span class="wordmark__rule" aria-hidden="true"></span>
  <span class="wordmark__sub" aria-hidden="true">STUDIO</span>
</span>
