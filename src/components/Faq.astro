---
// VISUAL RESET v2 §5.6 — FAQ: native <details>/<summary> accordion.
// No-JS first; smooth opening is added in Krok 3.
import T from './T.astro';
import { site } from '../data/site';
---

<section class="section faq" id={site.faq.id} aria-labelledby="faq-h2">
  <div class="container">
    <div class="faq__head">
      <h2 id="faq-h2">
        <T text={site.faq.heading} />
      </h2>
    </div>

    <div class="faq__list">
      {
        site.faq.items.map((item) => (
          <details class="faq-item">
            <summary>
              <T text={item.q} />
            </summary>
            <div class="faq-item__answer">
              <T text={item.a} />
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>
