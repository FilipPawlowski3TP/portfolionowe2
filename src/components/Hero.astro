---
// VISUAL PATCH v3 §3 — Hero (D1): 3-line H1 in one h1 (each line a block span
// with data-hero-line for the §4 kinetic pass), sub (lead + "Zadzwoń"/"Napisz"),
// foot row: latest realization (left) and scroll hint (right).
import T from './T.astro';
import { site } from '../data/site';

const project = site.projects[0];
---

<section class="hero" id="hero" data-hero>
  <!-- Krok 5 (owner wish): the hero wall gets a background — a faint
       graph-paper dot grid + a thin line-art wireframe of a website (the
       craft itself) with one --signal accent block. Decorative, aria-hidden,
       never over the text (z-index 0; content sits at z-index 1). -->
  <div class="hero__bg" aria-hidden="true">
    <svg class="hero__bg-art" viewBox="0 0 1440 900" preserveAspectRatio="xMidYMid slice" fill="none">
      <defs>
        <pattern id="hero-dots" width="32" height="32" patternUnits="userSpaceOnUse">
          <circle cx="2" cy="2" r="1.3" fill="currentColor"></circle>
        </pattern>
      </defs>
      <rect width="1440" height="900" fill="url(#hero-dots)" opacity="0.07"></rect>
      <g class="wire" stroke="currentColor" stroke-width="1.5">
        <rect x="858" y="140" width="470" height="600" rx="12" opacity="0.16"></rect>
        <line x1="858" y1="192" x2="1328" y2="192" opacity="0.16"></line>
        <circle cx="886" cy="166" r="5" opacity="0.16"></circle>
        <circle cx="910" cy="166" r="5" opacity="0.16"></circle>
        <circle cx="934" cy="166" r="5" opacity="0.16"></circle>
        <rect x="886" y="224" width="414" height="170" rx="8" fill="currentColor" stroke="none" opacity="0.06"></rect>
        <rect x="886" y="430" width="414" height="10" rx="5" fill="currentColor" stroke="none" opacity="0.1"></rect>
        <rect x="886" y="458" width="330" height="10" rx="5" fill="currentColor" stroke="none" opacity="0.1"></rect>
        <rect x="886" y="486" width="380" height="10" rx="5" fill="currentColor" stroke="none" opacity="0.1"></rect>
        <rect x="886" y="514" width="250" height="10" rx="5" fill="currentColor" stroke="none" opacity="0.1"></rect>
        <rect x="886" y="560" width="132" height="40" rx="20" fill="var(--signal)" stroke="none" opacity="0.85"></rect>
      </g>
    </svg>
  </div>
  <div class="container hero__inner">
    <h1 class="hero__h1">
      {
        site.hero.h1.map((line) => (
          <span class="hero__line" data-hero-line>
            <T text={line} />
          </span>
        ))
      }
    </h1>

    <div class="hero__sub" data-hero-sub>
      <p class="hero__lead">
        <T text={site.hero.lead} />
      </p>
      <div class="hero__ctas">
        {
          site.hero.ctas.map((cta) => (
            <a class={`btn btn--${cta.variant === 'outline' ? 'secondary' : 'primary'}`} href={cta.href}>
              <T text={cta.label} />
            </a>
          ))
        }
      </div>
    </div>

    <div class="hero__foot">
      <p class="hero__latest">
        Najnowsza realizacja:
        <a href="#realizacje">
          <T text={project.name} /> ↗
        </a>
      </p>
      <p class="hero__scroll">Przewiń ↓</p>
    </div>
  </div>
</section>
